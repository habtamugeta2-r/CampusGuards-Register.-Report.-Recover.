# ---------------------------------------------------------------------------
# CampusGuard environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL. In production this MUST be a server physically located in
# Ethiopia (Personal Data Protection Proclamation No. 1321/2024, Art. 22).
DATABASE_URL="postgresql://campusguard:change-me@127.0.0.1:5432/campusguard?schema=public"

# Public origin used in emails and printed under QR labels.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# bcrypt cost factor (12 is a reasonable default for 2026 hardware)
BCRYPT_ROUNDS=12

# Optional. Enables GET /api/health?deep=1 for an uptime/monitoring system
# without a user session (send it as the x-monitor-token header). Generate a
# long random value; treat it as a credential.
# MONITOR_TOKEN="<openssl rand -hex 32>"

# ---------------------------------------------------------------------------
# Email (optional). Without SMTP_HOST the app runs in log-only mode: messages
# are written to the server log and stay available as in-app notifications.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.aastu.edu.et
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="CampusGuard <no-reply@campusguard.local>"

# ---------------------------------------------------------------------------
# Deployment profile
# ALLOW_PREVIEW_EMBED=1 relaxes frame-ancestors so the app can be shown inside
# a hosted preview iframe. NEVER set this in production.
# ---------------------------------------------------------------------------
ALLOW_PREVIEW_EMBED=0
NODE_ENV=development
