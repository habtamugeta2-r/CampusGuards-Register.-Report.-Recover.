{
  "name": "campusguard",
  "version": "0.1.0",
  "private": true,
  "description": "CampusGuard — Register. Report. Recover. A campus property registration, reporting and recovery platform for Ethiopian higher-education institutions.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/lib/__tests__/**/*.test.ts\"",
    "db:up": "bash scripts/db.sh up",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "retention": "tsx scripts/retention-run.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "smoke": "tsx scripts/smoke.ts",
    "flow-test": "tsx scripts/flow-test.ts",
    "load-test": "tsx scripts/load-test.ts",
    "backup": "bash scripts/backup.sh backup",
    "a11y": "tsx scripts/a11y-audit.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "next": "^15.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
